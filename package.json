{
  "name": "mvsep-ableton-extension",
  "version": "1.2.0",
  "description": "AbleVSEP — Ableton Live extension that separates audio clips into stems via mvsep.com",
  "license": "MIT",
  "main": "dist/extension.js",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "setup": "node scripts/setup-sdk.mjs && pnpm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:dev": "pnpm run typecheck && tsx build.ts",
    "build": "pnpm run typecheck && tsx build.ts --production",
    "start": "pnpm run build:dev && tsx scripts/dev.ts",
    "dev:clean": "tsx scripts/dev.ts --reconcile-only",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli.tgz",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
