{
  "name": "mvsep-ableton-extension",
  "version": "1.0.1",
  "description": "AbleVSEP — Ableton Live extension that separates audio clips into stems via mvsep.com",
  "license": "MIT",
  "main": "dist/extension.js",
  "type": "module",
  "engines": { "node": ">=24.14.1" },
  "scripts": {
    "setup": "node scripts/setup-sdk.mjs && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:dev": "npm run typecheck && tsx build.ts",
    "build": "npm run typecheck && tsx build.ts --production",
    "start": "npm run build:dev && tsx scripts/dev.ts",
    "dev:clean": "tsx scripts/dev.ts --reconcile-only",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli.tgz",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
